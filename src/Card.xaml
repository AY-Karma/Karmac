<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:k="karmac"
        Title="Karmac" Width="392" Height="520" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="#FFFFFF" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <QuinticEase x:Key="EaseOut" EasingMode="EaseOut" />
    <SolidColorBrush x:Key="Tile" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="TileEdge" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Muted2" Color="#8CEBEBF5" />
    <!-- Earbud and case glyphs, after Apple's own part icons: a tilted head with a
         speaker mesh and an angled stem; the right bud mirrors the left. -->
    <GeometryGroup x:Key="BudHead" FillRule="EvenOdd">
      <EllipseGeometry Center="10,7.6" RadiusX="6.2" RadiusY="5" />
      <EllipseGeometry Center="5.9,7.4" RadiusX="1.4" RadiusY="2" />
    </GeometryGroup>
    <DrawingImage x:Key="BudLeft"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry></GeometryDrawing>
      <DrawingGroup>
        <DrawingGroup.Transform><RotateTransform Angle="-18" CenterX="12" CenterY="12" /></DrawingGroup.Transform>
        <GeometryDrawing Brush="#FFFFFF" Geometry="{StaticResource BudHead}" />
        <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="11.6,8.2,3.8,14" RadiusX="1.9" RadiusY="1.9" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="BudRight"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry></GeometryDrawing>
      <DrawingGroup>
        <DrawingGroup.Transform><TransformGroup><RotateTransform Angle="-18" CenterX="12" CenterY="12" /><ScaleTransform ScaleX="-1" CenterX="12" /></TransformGroup></DrawingGroup.Transform>
        <GeometryDrawing Brush="#FFFFFF" Geometry="{StaticResource BudHead}" />
        <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="11.6,8.2,3.8,14" RadiusX="1.9" RadiusY="1.9" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="CaseGlyph"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.8" /></GeometryDrawing.Pen>
        <GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="3,6,18,13.5" RadiusX="5" RadiusY="5" /><LineGeometry StartPoint="3.6,10.5" EndPoint="20.4,10.5" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="12,15" RadiusX="1" RadiusY="1" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <Geometry x:Key="Bolt">M 13,2 L 4,14 H 11 L 10,22 L 19,10 H 12 Z</Geometry>

    <!-- Capsule action. White is the one primary; Ghost is glass. Press shrinks to 0.97. -->
    <Style x:Key="Cta" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13.5" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="40" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#000000" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22" />
          <Border x:Name="Veil" Background="#808080" CornerRadius="22" Opacity="0" />
          <Border x:Name="Ring" BorderBrush="#0A84FF" BorderThickness="2" CornerRadius="25" Margin="-3" Opacity="0" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.14" /></Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Veil" Property="Opacity" Value="0.24" />
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.1" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.1" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Cta}">
      <Setter Property="Background" Value="#14FFFFFF" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#14FFFFFF" />
    </Style>

    <Style x:Key="TileBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Tile}" /><Setter Property="BorderBrush" Value="{StaticResource TileEdge}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="BatteryTile" TargetType="Border" BasedOn="{StaticResource TileBox}">
      <Setter Property="Padding" Value="0,14,0,12" />
    </Style>
    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,7,0,0" /><Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Part" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource Muted2}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style x:Key="BoltBadge" TargetType="Grid">
      <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="0,-3,-3,0" /><Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="CardClose" TargetType="Button">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Ellipse x:Name="Disc" Fill="#14FFFFFF" />
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#C7EBEBF5" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="#29FFFFFF" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <Border x:Name="Sheet" Width="344" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,12" Background="#000000" CornerRadius="26" BorderThickness="1" Cursor="Hand">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2EFFFFFF" Offset="0" /><GradientStop Color="#14FFFFFF" Offset="0.4" /><GradientStop Color="#12FFFFFF" Offset="1" /></LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.75" BlurRadius="40" ShadowDepth="14" Direction="270" /></Border.Effect>
      <Grid>
        <StackPanel Margin="0,0,0,14">
          <Grid x:Name="CardStage" Height="176" ClipToBounds="True">
            <Grid.Background>
              <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="0.85">
                <GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" />
              </RadialGradientBrush>
            </Grid.Background>
            <Ellipse Width="200" Height="22" VerticalAlignment="Bottom" Margin="0,0,0,10" IsHitTestVisible="False">
              <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Image x:Name="CardArtwork" Height="146" MaxWidth="240" VerticalAlignment="Bottom" Margin="0,0,0,8" RenderTransformOrigin="0.5,0.85">
              <Image.Effect><DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="24" ShadowDepth="14" Direction="270" /></Image.Effect>
            </Image>
          </Grid>
          <TextBlock x:Name="CardName" Text="AirPods" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="20,8,20,0" />
          <TextBlock x:Name="CardStatus" Text="Connected" FontSize="12" Foreground="{StaticResource Muted2}" HorizontalAlignment="Center" Margin="20,2,20,0" />
          <Grid x:Name="CardBattery" Margin="14,16,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border x:Name="CardLeftCell" Style="{StaticResource BatteryTile}">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="54" Height="54">
                    <k:RingGauge x:Name="CardLeftRing" StrokeWidth="5" ShowLabel="False" Track="#1FFFFFFF" Fill="#FFFFFF" Ink="#FFFFFF" />
                    <Image Source="{StaticResource BudLeft}" Width="24" Height="24" />
                    <Grid x:Name="CardLeftBolt" Style="{StaticResource BoltBadge}">
                      <Ellipse Fill="#30D158" Stroke="#000000" StrokeThickness="2.5" Margin="-2.5" />
                      <Path Data="{StaticResource Bolt}" Fill="#000000" Stretch="Uniform" Width="9" Height="11" />
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="CardLeftPct" Text="—" Style="{StaticResource Figure}" />
                  <TextBlock Text="Left" Style="{StaticResource Part}" />
                </StackPanel>
              </Border>
              <Border x:Name="CardRightCell" Grid.Column="2" Style="{StaticResource BatteryTile}">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="54" Height="54">
                    <k:RingGauge x:Name="CardRightRing" StrokeWidth="5" ShowLabel="False" Track="#1FFFFFFF" Fill="#FFFFFF" Ink="#FFFFFF" />
                    <Image Source="{StaticResource BudRight}" Width="24" Height="24" />
                    <Grid x:Name="CardRightBolt" Style="{StaticResource BoltBadge}">
                      <Ellipse Fill="#30D158" Stroke="#000000" StrokeThickness="2.5" Margin="-2.5" />
                      <Path Data="{StaticResource Bolt}" Fill="#000000" Stretch="Uniform" Width="9" Height="11" />
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="CardRightPct" Text="—" Style="{StaticResource Figure}" />
                  <TextBlock Text="Right" Style="{StaticResource Part}" />
                </StackPanel>
              </Border>
              <Border x:Name="CardCaseCell" Grid.Column="4" Style="{StaticResource BatteryTile}">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="54" Height="54">
                    <k:RingGauge x:Name="CardCaseRing" StrokeWidth="5" ShowLabel="False" Track="#1FFFFFFF" Fill="#FFFFFF" Ink="#FFFFFF" />
                    <Image Source="{StaticResource CaseGlyph}" Width="24" Height="24" />
                    <Grid x:Name="CardCaseBolt" Style="{StaticResource BoltBadge}">
                      <Ellipse Fill="#30D158" Stroke="#000000" StrokeThickness="2.5" Margin="-2.5" />
                      <Path Data="{StaticResource Bolt}" Fill="#000000" Stretch="Uniform" Width="9" Height="11" />
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="CardCasePct" Text="—" Style="{StaticResource Figure}" />
                  <TextBlock Text="Case" Style="{StaticResource Part}" />
                </StackPanel>
              </Border>
          </Grid>
          <Button x:Name="CardAction" Style="{StaticResource Cta}" Content="Connect" Margin="14,14,14,0" Visibility="Collapsed" />
        </StackPanel>
        <Button x:Name="CardClose" Style="{StaticResource CardClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
      </Grid>
    </Border>
  </Grid>
</Window>
