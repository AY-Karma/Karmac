      <GeometryDrawing Brush="#DCDCDC"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="49,24" RadiusX="6" RadiusY="8" /><EllipseGeometry Center="155,24" RadiusX="6" RadiusY="8" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <DrawingImage x:Key="PodsArtwork">
      <DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#B8D5CA" Geometry="M 42,185 C 42,178 184,178 184,185 C 184,194 42,194 42,185 Z" />
        <DrawingGroup><DrawingGroup.Transform><RotateTransform Angle="-16" CenterX="78" CenterY="85" /></DrawingGroup.Transform>
          <GeometryDrawing Brush="{StaticResource PodWhite}"><GeometryDrawing.Pen><Pen Brush="#CDD5D1" Thickness="1.2" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup>
            <PathGeometry Figures="M 64,70 C 48,63 39,47 43,34 C 46,21 66,18 82,23 C 101,28 108,45 102,61 C 99,70 92,75 87,76 L 86,146 C 86,160 68,161 67,148 Z" />
          </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#28312F" Geometry="M 51,35 C 47,41 50,50 56,53 C 61,56 68,49 65,42 C 63,36 55,31 51,35 Z" />
          <GeometryDrawing Brush="#A6B2AD" Geometry="M 72,142 L 81,142 L 81,150 C 81,154 72,154 72,150 Z" />
          <GeometryDrawing Brush="#778D83" Geometry="M 85,35 A 3,2 0 1 0 91,37 A 3,2 0 1 0 85,35" />
        </DrawingGroup>
        <DrawingGroup><DrawingGroup.Transform><RotateTransform Angle="17" CenterX="155" CenterY="85" /></DrawingGroup.Transform>
          <GeometryDrawing Brush="{StaticResource PodWhite}"><GeometryDrawing.Pen><Pen Brush="#CDD5D1" Thickness="1.2" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M 150,76 C 131,72 126,59 129,43 C 132,26 149,18 166,23 C 184,27 192,42 184,57 C 180,65 169,69 168,76 L 168,147 C 168,161 150,160 150,147 Z" /></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#28312F" Geometry="M 172,34 C 165,38 166,47 172,51 C 178,55 184,47 181,40 C 179,35 176,33 172,34 Z" />
          <GeometryDrawing Brush="#A6B2AD" Geometry="M 154,142 L 164,142 L 164,150 C 164,154 154,154 154,150 Z" />
          <GeometryDrawing Brush="#778D83" Geometry="M 140,35 A 3,2 0 1 0 146,33 A 3,2 0 1 0 140,35" />
        </DrawingGroup>
      </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
  </Window.Resources>
  <Border Background="#000000" BorderBrush="#242424" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="Transparent" Margin="28,0,14,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Karmac" FontSize="14" Foreground="#C8C8C8" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource ChromeButton}" ToolTip="Settings and connection tools" AutomationProperties.Name="Settings and connection tools" />
          <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource ChromeButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
          <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource ChromeButton}" ToolTip="Close to tray" AutomationProperties.Name="Close window" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel">
            <Setter Property="Margin" Value="28,0,28,28" />
            <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
              <Setter Property="Margin" Value="28,0,28,8" />
            </DataTrigger></Style.Triggers>
          </Style></StackPanel.Style>
          <StackPanel x:Name="MainPanel">
            <Grid x:Name="ArtworkStage" Height="210" Margin="0,0,0,18">
              <Image x:Name="DeviceArtwork" Source="{StaticResource PodsArtwork}" Width="238" Height="181" VerticalAlignment="Top" Margin="0,7,0,0" AutomationProperties.Name="Selected Apple audio model" />
              <TextBlock x:Name="ModelLabel" Text="APPLE AUDIO" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            </Grid>
            <Grid x:Name="DeviceNameRow">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="DevicePicker" DisplayMemberPath="Name" AutomationProperties.Name="Your paired Apple headphones" ToolTip="Choose from your paired AirPods and Beats" />
              <Border x:Name="StatusPanel" Grid.Column="2" Background="#000000" BorderThickness="0" Padding="0,5" MaxWidth="158" VerticalAlignment="Center" Focusable="True" KeyboardNavigation.IsTabStop="False" ToolTip="Looking for your saved audio endpoint." ToolTipService.ShowDuration="30000">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" MaxWidth="104">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#808080" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="ConnectionBadge" Text="Checking" FontSize="11" Foreground="#DADADA" TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock x:Name="StatusTitle" Text="Getting ready" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="13,4,0,0" />
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="2" Margin="13,5,0,0" Foreground="#F5F5F5" Background="#292929" BorderThickness="0" />
                  </StackPanel>
                  <ToggleButton x:Name="ConnectionToggle" Grid.Column="2" Style="{StaticResource ConnectionSwitch}" VerticalAlignment="Center" IsThreeState="False" AutomationProperties.Name="Headphone connection and laptop Bluetooth" AutomationProperties.HelpText="On turns Bluetooth on and connects the selected headphones. Off turns Bluetooth off for the entire laptop, including other Bluetooth devices." ToolTip="On: turn Bluetooth on and connect the selected headphones.&#x0a;Off: turn Bluetooth off across this laptop." ToolTipService.ShowOnDisabled="True" />
                </Grid>
              </Border>
            </Grid>
            <TextBlock x:Name="DeviceSubtitle" Text="Finding your paired headphones…" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
            <Grid x:Name="MainActions">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" Background="#F5F5F5" Foreground="#000000" BorderBrush="#F5F5F5" MinHeight="48" Padding="16,12" FontSize="15" Content="Connect headphones" Margin="0,18,0,0" AutomationProperties.Name="Connect selected headphones" ToolTip="Connect your saved headphones and apply your audio routing preference" />
            <Button x:Name="SetupButton" Visibility="Collapsed" Background="#F5F5F5" Foreground="#000000" BorderBrush="#F5F5F5" MinHeight="48" Padding="16,12" FontSize="14" Content="Pair headphones in Windows" Margin="0,18,0,0" AutomationProperties.Name="Open Windows Bluetooth settings to pair headphones" />
            <Border x:Name="ReadyPanel" Visibility="Collapsed" Background="#000000" BorderThickness="0" MinHeight="48" Padding="0,10" Margin="0,18,0,0" AutomationProperties.Name="Connected. Audio output active.">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path Data="M 1,6 L 5,10 L 13,2" Stroke="#4ADE80" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Connected" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Audio output active" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </Border>

              <Button x:Name="MainDisconnectButton" Grid.Column="1" Content="Disconnect" Visibility="Collapsed" Style="{StaticResource TextAction}" MinHeight="48" FontSize="13" Margin="20,18,0,0" AutomationProperties.Name="Disconnect selected headphones" ToolTip="Disconnect your headphones; keep them paired for the next connection" />
            </Grid>
            <Button x:Name="ConnectionDetailsButton" Visibility="Collapsed" Content="Connection details ›" Style="{StaticResource TextAction}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            <StackPanel x:Name="ConnectionStream" Visibility="Collapsed" Margin="0,20,0,0" AutomationProperties.LiveSetting="Polite">
              <Grid Margin="0,0,0,9">
                <TextBlock x:Name="ConnectionStreamLabel" Text="LIVE CONNECTION" FontSize="10" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="ConnectionElapsed" Text="0.0 s" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
              </Grid>
              <TextBlock x:Name="ConnectionTitle" Text="Checking Bluetooth" FontSize="19" />
              <TextBlock x:Name="ConnectionDetail" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,12" />
              <ItemsControl x:Name="ConnectionSteps">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5" AutomationProperties.Name="{Binding Accessible}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                  <Ellipse Width="6" Height="6" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding Pulse}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard x:Name="StagePulse"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="StagePulse" /></DataTrigger.ExitActions>
                    </DataTrigger></Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="{Binding TextColor}" />
                  <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" TextAlignment="Right" Foreground="{StaticResource Muted}" />
                </Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border x:Name="BatterySection" BorderThickness="0" Padding="0,18,0,0" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,17">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Battery" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock x:Name="BatteryStatus" Grid.Column="1" Text="Automatic" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                  <Button x:Name="BatterySourceButton" Grid.Column="2" Content="Choose source ›" Style="{StaticResource TextAction}" Margin="16,0,0,0" AutomationProperties.Name="Choose an optional manual battery broadcast source" />
                </Grid>
                <UniformGrid x:Name="BatteryLevels" Columns="3">
                  <Border x:Name="LeftBatteryCell" Padding="0,0,18,0" BorderBrush="#242424" BorderThickness="0,0,1,0"><StackPanel>
                    <TextBlock x:Name="LeftBatteryLabel" Text="Left" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="LeftBattery" Text="—" FontSize="29" Margin="0,6,0,8" AutomationProperties.Name="Left earbud battery" />
                    <ProgressBar x:Name="LeftBar" Height="2" BorderThickness="0" Foreground="#F5F5F5" Background="#292929" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="LeftDetail" Text="No reading" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                  </StackPanel></Border>
                  <Border x:Name="RightBatteryCell" Padding="18,0" BorderBrush="#242424" BorderThickness="0,0,1,0"><StackPanel>
                    <TextBlock x:Name="RightBatteryLabel" Text="Right" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="RightBattery" Text="—" FontSize="29" Margin="0,6,0,8" AutomationProperties.Name="Right earbud battery" />
                    <ProgressBar x:Name="RightBar" Height="2" BorderThickness="0" Foreground="#F5F5F5" Background="#292929" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="RightDetail" Text="No reading" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                  </StackPanel></Border>
                  <Border x:Name="CaseBatteryCell" Padding="18,0,0,0"><StackPanel>
                    <TextBlock x:Name="CaseBatteryLabel" Text="Case" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="CaseBattery" Text="—" FontSize="29" Margin="0,6,0,8" AutomationProperties.Name="Charging case battery" />
                    <ProgressBar x:Name="CaseBar" Height="2" BorderThickness="0" Foreground="#F5F5F5" Background="#292929" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="CaseDetail" Text="No reading" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                  </StackPanel></Border>
                </UniformGrid>
                <TextBlock x:Name="BatteryNote" Text="Updates automatically when your headphones share battery data." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border x:Name="BatterySourcePanel" Visibility="Collapsed" Background="#000000" Padding="0,6,0,0">
            <StackPanel>
              <Button x:Name="BatteryBackButton" Content="‹  Back" Style="{StaticResource TextAction}" HorizontalAlignment="Left" />
              <TextBlock Text="Battery source" FontSize="27" Margin="0,18,0,8" />
              <TextBlock x:Name="BatterySourceTarget" FontSize="13" Margin="0,0,0,18" />
              <TextBlock Text="These nearby broadcasts are not verified as your pair. Choose one to display its readings as user-selected. Automatic device-matched readings take priority." FontSize="12" Foreground="{StaticResource Muted}" />
              <TextBlock x:Name="BatterySourceEmpty" Text="Listening for nearby broadcasts…" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,24,0,16" />
              <ListBox x:Name="BatterySourcesList" Background="#000000" Foreground="#F2F2F2" BorderThickness="0" MaxHeight="255" Margin="0,16,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Nearby battery broadcasts">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0,13" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Foreground" Value="#E5E5E5" />
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid Background="#000000">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                    <Path x:Name="ChoiceMark" Grid.Column="1" Data="M 1,6 L 5,10 L 13,2" Stroke="White" StrokeThickness="1.8" VerticalAlignment="Center" Visibility="Collapsed" />
                  </Grid><ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceMark" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="16" />
                  <TextBlock Text="{Binding Detail}" FontSize="13" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding Signal}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Charge is approximate, in 10% steps. Your selection stays in this app session for up to 30 minutes and expires if its broadcast goes stale; rotating addresses may need a new selection." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,18,0,16" />
              <Button x:Name="UseBatterySourceButton" Content="Use this source" IsEnabled="False" Background="#F5F5F5" Foreground="#000000" BorderBrush="#F5F5F5" MinHeight="44" />
              <Button x:Name="AutomaticBatteryButton" Content="Use automatic detection only" Style="{StaticResource TextAction}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#000000" Padding="0,6,0,0">
            <StackPanel>
              <Button x:Name="BackButton" Content="‹  Back" Style="{StaticResource SettingsTextAction}" HorizontalAlignment="Left" ToolTip="Back to your headphones" />
              <Grid Margin="0,12,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Settings" FontSize="27" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,4,0,0">
                  <Ellipse x:Name="RadioDot" Width="6" Height="6" Fill="#808080" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock x:Name="RadioLabel" Text="Checking Bluetooth" FontSize="10" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="CONNECTION" Style="{StaticResource SettingsSectionLabel}" />
              <CheckBox x:Name="AutoRouteCheck" Style="{StaticResource SettingsPreference}" AutomationProperties.Name="Use as audio output" AutomationProperties.HelpText="Make these headphones the Windows output when connecting.">
                <StackPanel>
                  <TextBlock Text="Use as audio output" />
                  <TextBlock Text="Switch Windows audio to your headphones on connect." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="PowerOffBluetoothCheck" Style="{StaticResource SettingsPreference}" AutomationProperties.Name="Turn off laptop Bluetooth when disconnecting" ToolTip="On: disconnect all Bluetooth devices on this laptop. Off: disconnect only the selected headphones and leave Bluetooth enabled.">
                <StackPanel>
                  <TextBlock Text="Turn off laptop Bluetooth when disconnecting" />
                  <TextBlock x:Name="DisconnectScopeHint" Text="Also disconnects Bluetooth mice, keyboards and other devices." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </CheckBox>

              <TextBlock Text="OPENCONNECT" Style="{StaticResource SettingsSectionLabel}" />
              <CheckBox x:Name="TrayCheck" Style="{StaticResource SettingsPreference}" AutomationProperties.Name="Keep running in the tray">
                <StackPanel>
                  <TextBlock Text="Keep running in the tray" />
                  <TextBlock Text="Closing the window keeps quick connect available." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="HotkeyCheck" Style="{StaticResource SettingsPreference}" AutomationProperties.Name="Keyboard shortcut" AutomationProperties.HelpText="Ctrl + Shift + A to connect.">
                <StackPanel>
                  <TextBlock Text="Keyboard shortcut" />
                  <TextBlock Text="Ctrl + Shift + A to connect" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                  <TextBlock x:Name="ShortcutHint" Text="Shortcut in use by another app" FontSize="11" Foreground="#FBBF24" Margin="0,5,0,0" Visibility="Collapsed" />
                </StackPanel>
              </CheckBox>

              <Border BorderBrush="#242424" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,15,0,0">
                <StackPanel>
                  <TextBlock Text="CONNECTION TOOLS" Style="{StaticResource SettingsSectionLabel}" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button x:Name="RouteButton" Content="Switch audio now" Style="{StaticResource SettingsTextAction}" ToolTip="Make the selected headphones the Windows output for music and calls" Margin="0,0,12,0" />
                    <Button x:Name="DisconnectButton" Grid.Column="1" Content="Turn Bluetooth off" Style="{StaticResource SettingsTextAction}" ToolTip="Disconnects all Bluetooth devices on this laptop" />
                    <Button x:Name="RefreshButton" Grid.Row="1" Content="Refresh devices" Style="{StaticResource SettingsTextAction}" Margin="0,0,12,0" />
                    <Button x:Name="PairButton" Grid.Row="1" Grid.Column="1" Content="Pair in Windows ↗" Style="{StaticResource SettingsTextAction}" ToolTip="Open Windows Bluetooth settings to pair a new device" />
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#000000">
        <Border.Style><Style TargetType="Border">
          <Setter Property="Padding" Value="28,8,28,12" />
          <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
            <Setter Property="Padding" Value="28,0,28,6" />
          </DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <Grid>
          <TextBlock x:Name="CopyrightLabel" Text="AY-Karma (c)" Foreground="#787878" FontSize="10" HorizontalAlignment="Left" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Grid>
            <Grid.Style><Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Karmac 1.0" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="AY-Karma (c)" FontSize="10" Foreground="#787878" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
            <Button x:Name="LicenseButton" Grid.Column="2" Content="Notices" AutomationProperties.Name="Open-source notices" ToolTip="Open-source licenses and artwork notices" Style="{StaticResource SettingsTextAction}" FontSize="11" />
            <Button x:Name="QuitButton" Grid.Column="4" Content="Quit app" Style="{StaticResource SettingsTextAction}" FontSize="11" HorizontalAlignment="Right" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
